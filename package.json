{
  "name": "@moonjellydigital/prettier-config",
  "description": "Prettier shareable config",
  "version": "1.1.0",
  "main": "index.json",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "Camille Spain <camille@camillespain.com>",
  "license": "MIT",
  "keywords": [
    "prettier",
    "prettier-config"
  ],
  "homepage": "https://github.com/moonjellydigital/prettier-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonjellydigital/prettier-config.git"
  },
  "files": [
    "./index.json",
    "./CHANGELOG.md"
  ],
  "prettier": "./index.json",
  "scripts": {
    "test": "bun test",
    "prepare": "husky || true",
    "tsc:ci": "bunx tsc",
    "fmt:ci": "bunx prettier --check .",
    "lint:ci": "bunx eslint ."
  },
  "lint-staged": {
    "*.{json,yml,yaml,md}": "prettier --write",
    "*.{ts,js}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/prettier": "^3.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
